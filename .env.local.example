# FORTIS OS local development configuration.
# Copy to .env.local. Never commit populated environment files.

# Core
DATABASE_URL=postgresql://user:password@localhost:5432/fortis
NEXTAUTH_SECRET=replace-with-at-least-32-random-characters
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Runtime safety. Production blocks modules that have not passed readiness gates.
FORTIS_ALLOW_NON_PRODUCTION_MODULES=false

# Optional email provider
RESEND_API_KEY=
EMAIL_FROM=FORTIS OS <noreply@example.com>

# Optional payment sandbox; no live credentials belong in this file
PAYMENT_PROVIDER=sandbox
PAYMENT_WEBHOOK_SECRET=

# Optional self-hosted OpenAI-compatible inference endpoint.
# Paid third-party AI is not required and is disabled by default.
LOCAL_AI_BASE_URL=
LOCAL_AI_MODEL=
LOCAL_AI_API_KEY=

# Scheduled job authentication
CRON_SECRET=
FORTIS_CREDENTIAL_SECRET=
FORTIS_SANDBOX_WEBHOOK_SECRET=
FORTIS_TRANSFER_ACCOUNT_NAME=FORTIS INVICTA LTD
FORTIS_TRANSFER_ACCOUNT_NUMBER=replace-with-operator-account
FORTIS_TRANSFER_BANK=Nominated bank / Wave / QMoney
